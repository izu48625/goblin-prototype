{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stats-maker-web",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-08",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/p/*",
      "/work/*",
      "/sitemap.xml",
      "/sitemap-static.xml",
      "/sitemap-works-*.xml",
      "/api/og*",
      "/api/health",
      "/api/security/*",
      "/api/guard/*",
      "/api/report/*",
      "/api/discover"
    ]
  },
  "ratelimits": [
    {
      "name": "OG_RATE_LIMIT",
      "namespace_id": "2601",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "COMMUNITY_GATEWAY_RATE_LIMIT",
      "namespace_id": "2603",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE_LIMIT",
      "namespace_id": "2604",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "SHARE_RATE_LIMIT",
      "namespace_id": "2602",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "DISCOVER_RATE_LIMIT",
      "namespace_id": "2605",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ],
  "previews": {
    "ratelimits": [
      {
        "name": "OG_RATE_LIMIT",
        "namespace_id": "726101",
        "simple": {
          "limit": 90,
          "period": 60
        }
      },
      {
        "name": "COMMUNITY_GATEWAY_RATE_LIMIT",
        "namespace_id": "726103",
        "simple": {
          "limit": 30,
          "period": 60
        }
      },
      {
        "name": "REPORT_RATE_LIMIT",
        "namespace_id": "726104",
        "simple": {
          "limit": 6,
          "period": 60
        }
      },
      {
        "name": "SHARE_RATE_LIMIT",
        "namespace_id": "726102",
        "simple": {
          "limit": 300,
          "period": 60
        }
      },
      {
        "name": "DISCOVER_RATE_LIMIT",
        "namespace_id": "726105",
        "simple": {
          "limit": 90,
          "period": 60
        }
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
